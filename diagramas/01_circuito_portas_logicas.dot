
digraph G {
 graph [rankdir=LR, bgcolor="white", pad="0.22", nodesep="0.32", ranksep="0.70", splines=polyline, fontname="DejaVu Sans", label="MGPEB  |  Lógica de autorização de pouso", labelloc=t, fontsize=19, fontcolor="#152130"];
 node [shape=box, style="rounded,filled", color="#ced8e4", fillcolor="#f4f7fb", fontcolor="#152130", fontname="DejaVu Sans", fontsize=11, margin="0.16,0.13"];
 edge [color="#7d91a6", arrowsize=0.70, penwidth=1.5];
 C [label="C\nCombustível >= 25%"];
 W [label="W\nVento <= 40 km/h"];
 L [label="L\nVisibilidade >= 60/100"];
 P [label="P\n650 <= Pressão <= 850 Pa"];
 T [label="T\n-90 <= Temp. <= -5 °C"];
 I [label="I\nIntegridade OK"];
 S1 [label="S1\nSensor principal OK"];
 S2 [label="S2\nSensor reserva OK"];
 A [label="A\nÁrea livre"];
 G [label="G\nAlerta global ativo"];
 H [label="H\nAltitude <= 500 m"];
 node [shape=hexagon, style=filled, fillcolor="#e8f4fb", color="#55a8c7", fontsize=12, fontcolor="#145f79", width=1.05, height=0.5];
 ANDat [label="AND"]; ORsen [label="OR"]; NEG [label="NOT"]; ANDfin [label="AND\nTODOS", fillcolor="#ffeaf2", color="#ed1266", fontcolor="#a10f45"];
 node [shape=box, style="rounded,filled", fillcolor="#e6f6ef", color="#53b18b", fontsize=12, fontcolor="#116f50"];
 OUT [label="Pouso\nAUTORIZADO"];
 {rank=same; C; W; L; P; T; I; S1; S2; A; G; H}
 W -> ANDat; L -> ANDat;
 S1 -> ORsen; S2 -> ORsen;
 G -> NEG;
 C -> ANDfin; ANDat -> ANDfin; P -> ANDfin; T -> ANDfin; I -> ANDfin; ORsen -> ANDfin; A -> ANDfin; NEG -> ANDfin; H -> ANDfin; ANDfin -> OUT;
}
